# Copy to .env and fill in. .env is gitignored; this template is committed.

# Database (Postgres). Used by prisma.config.ts (Migrate) and the runtime
# driver adapter in lib/db.ts.
DATABASE_URL="postgresql://user:password@localhost:5432/game_planning?schema=public"

# Auth.js v5 (NextAuth). Generate a secret with: npx auth secret
AUTH_SECRET=""
# AUTH_URL is optional in dev; set in production to the deployed origin.
# AUTH_URL="http://localhost:3000"

# Email (Resend) — admin notification on new user sign-up
RESEND_API_KEY=""
ADMIN_EMAIL=""
MAIL_FROM_EMAIL="gameplan@yourdomain.com"
MAIL_FROM_NAME="GamePlan"
